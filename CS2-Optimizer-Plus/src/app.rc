// src/app.rc — 嵌入清单 + 版本信息 (windres 与 rc.exe 均兼容)
// 数字形式: 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST
#include <winver.h>

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION    2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS         0x40004
FILETYPE       0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "YG"
            VALUE "FileDescription",  "CS2 FPS & Latency Optimizer Panel (Pure C Win32)"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "ProductName",      "CS2_Optimizer_Win32"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
